<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- xosvid（root 守护）签名用。xosvid 以 launchd 守护身份常驻，
     要向 launchd 注册 MachService，必须有 XPC 服务白名单 + 无沙盒 +
     绝对路径读写。wiki.qaq.xosvi.client 是「谁能当客户端」的标记，
     守护自身不带它（带与不带由 xpc_connection_has_bool_entitlement 判）。 -->
<plist version="1.0">
<dict>
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<key>com.apple.private.security.container-required</key>
	<false/>
	<key>com.apple.private.security.no-container</key>
	<true/>
	<key>com.apple.private.security.container-manager</key>
	<true/>
	<key>com.apple.private.security.storage.AppBundles</key>
	<true/>
	<key>com.apple.private.security.storage.AppDataContainers</key>
	<true/>
	<key>com.apple.security.exception.files.absolute-path.read-write</key>
	<array>
		<string>/</string>
	</array>
	<key>com.apple.private.launchservices.mach-services</key>
	<array>
		<string>wiki.qaq.xosvi.service</string>
	</array>
</dict>
</plist>
